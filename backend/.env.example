# ─────────────────────────────────────────────────────────────
# xhs-content-insight - Backend .env example
#
# 合规红线(详见仓库根目录 docs/compliance.md):
#   * 仅供学习研究和小规模数据分析,严禁用于自动化营销 / 批量发布 / 商业用途
#   * 后端默认仅本机监听,严禁修改 HOST 为 127.0.0.1 之外的任何取值
#   * 单次采集 ≤ 20 条笔记,二级评论仅取热门 Top N(默认 5)
#   * 严禁向 data/ 目录之外的磁盘路径或第三方对象存储写入采集数据
# ─────────────────────────────────────────────────────────────

# ---- HTTP 服务监听 ----
# HOST 仅允许 127.0.0.1(本机回环);任何允许非本机访问的取值都违反合规边界。
HOST=127.0.0.1
PORT=8000

# ---- MediaCrawler 子模块路径 ----
# 相对仓库根目录的路径(运行时由 backend/app/core/config.py 解析为绝对路径)。
# 严禁将子模块迁移到 third_party/MediaCrawler 之外,且严禁修改其源码。
MEDIA_CRAWLER_ROOT=third_party/MediaCrawler

# 用于启动 MediaCrawler 子进程的 Python 解释器路径,留空则使用当前后端进程的解释器。
MEDIA_CRAWLER_PYTHON=

# ---- 采集与处理参数 ----
# MediaCrawler 子进程超时时间(秒),超时后强制终止子进程。
CRAWL_TIMEOUT_SECONDS=600
# 单条笔记保留的热门二级评论条数上限。
HOT_COMMENT_TOP_N=5

# ---- AI Provider 配置 ----
# 可选值:openai / deepseek / gemini(忽略大小写)。
AI_PROVIDER=openai
# 单次 LLM 调用超时时间(秒)。
LLM_API_TIMEOUT_SECONDS=120
# 估算的模型上下文 token 上限,build_prompt 不得超过该值。
MODEL_CONTEXT_LIMIT=8000

# 各 Provider 的 API Key 按需配置(本地调试用,不要提交真实值)。
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
GEMINI_API_KEY=

# ---- 本地存储 ----
# 归档 JSON 目录,相对仓库根目录。严禁配置为 data/ 之外的路径。
JSON_ARCHIVE_DIR=data/json
