HOST=127.0.0.1
PORT=8000

# MediaCrawler
MEDIA_CRAWLER_ROOT=third_party/MediaCrawler
# Optional. If omitted, the backend will prefer third_party/MediaCrawler/.venv
# when present, otherwise it falls back to the backend Python interpreter.
# Windows example:
# MEDIA_CRAWLER_PYTHON=D:\ai-coding\xhs\third_party\MediaCrawler\.venv\Scripts\python.exe
# macOS/Linux example:
# MEDIA_CRAWLER_PYTHON=/path/to/xhs/third_party/MediaCrawler/.venv/bin/python
# Use cookie mode for web-triggered crawls so the backend does not block on
# interactive QR-code windows. Fill cookies when the platform login expires.
MEDIA_CRAWLER_LOGIN_TYPE=cookie
MEDIA_CRAWLER_COOKIES=
CRAWL_TIMEOUT_SECONDS=600

# AI reports
# Pick one provider in the UI, then set its matching key here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Development-only fallback. Set true to generate a local mock report
# without calling an external model.
MOCK_AI_REPORT=false
